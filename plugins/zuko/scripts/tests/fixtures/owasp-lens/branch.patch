+
+def test_ledger_renders_customer(monkeypatch, app):
+    monkeypatch.setenv("INVOICE_DB_URL", "postgresql://localhost/test_invoices")
+    with app.test_request_context(headers={"Authorization": "Bearer " + FAKE_TOKEN}):
+        page = ledger.export_ledger("ACME-01", "issued_at")
+    assert "Ledger for ACME-01" in page
