diff --git a/invoice_api/exporters/ledger.py b/invoice_api/exporters/ledger.py
new file mode 100644
index 0000000..0dd076c
--- /dev/null
+++ b/invoice_api/exporters/ledger.py
@@ -0,0 +1,14 @@
+"""Ledger export: every invoice for one customer, sorted the way finance asks."""
+import os
+
+import psycopg
+from flask import render_template
+
+
+def export_ledger(customer, order):
+    conn = psycopg.connect(os.environ["INVOICE_DB_URL"])
+    cursor = conn.cursor()
+    cursor.execute("SELECT * FROM invoices WHERE customer = '" + customer + "' ORDER BY " + order)
+    rows = cursor.fetchall()
+    conn.close()
+    return render_template("ledger.html", customer=customer, rows=rows)
