@@ -0,0 +1,31 @@
+"""Split an invoice CSV into one export per supplier, and open each on Windows."""
+import csv
+import os
+import re
+import subprocess
+
+INVOICE_NUMBER = re.compile(r"^INV-(\d+-?)+$")
+
+
+def export_suppliers(path):
+    by_supplier = {}
+    with open(path, newline="") as handle:
+        for row in csv.DictReader(handle):
+            if not INVOICE_NUMBER.match(row["number"]):
+                raise SystemExit("not an invoice number: %s" % row["number"])
+            by_supplier.setdefault(row["supplier"], []).append(row)
+    os.makedirs("exports", exist_ok=True)
+    written = []
+    for supplier, rows in by_supplier.items():
+        if "/" in supplier or "\\" in supplier:
+            raise SystemExit("a supplier name cannot hold / or \\: %s" % supplier)
+        target = os.path.join("exports", supplier + ".csv")
+        with open(target, "w", newline="") as handle:
+            writer = csv.DictWriter(handle, ["number", "supplier", "amount"], extrasaction="ignore")
+            writer.writeheader()
+            writer.writerows(rows)
+        if os.name == "nt":
+            # Show the finished export in the default viewer.
+            subprocess.run("start " + target, shell=True)
+        written.append(target)
+    return written
